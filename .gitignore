coverage/
outputs/
work/
# Installed data and local-only evidence. Selected authored tools are explicitly tracked.
/public/
/source-geodata/
/source-pathadvisor/
/source-photo-references/
/docs/source-evidence-v4/
/docs/screenshots/
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.webp
/docs/**/*.glb
/docs/**/*.pdf

# Historical raw registry input is local data, not source code.
/scripts/registry-v3/input-entity-registry.json

# Generated historical QA/source reports stay with the complete local workspace.
/docs/*.json
/docs/*.txt
/docs/source-evidence-*/

# Each version owns its complete local materials. Never publish private materials in Git.
/versions/*/public/
/versions/*/source-*/
/versions/*/docs/*.json
/versions/*/docs/*.txt
/versions/*/docs/source-evidence-*/
/versions/*/docs/screenshots/
/versions/*/docs/**/*.png
/versions/*/docs/**/*.jpg
/versions/*/docs/**/*.jpeg
/versions/*/docs/**/*.webp
/versions/*/docs/**/*.glb
/versions/*/docs/**/*.pdf
/versions/*/scripts/registry-v3/input-entity-registry.json
/versions/*/INVENTORY.local.json
